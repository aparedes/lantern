{
  "extends": "../../../tsconfig.module.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./dist"
  },
  "references": [
    { "path": "../test" },
    { "path": "../../core/cli-core" },
    { "path": "../../core/logger" },
    { "path": "../../platforms/profiler" },
    { "path": "../../core/shell" },
    { "path": "../../core/types" },
    { "path": "../../core/web-reporter-ui" }
  ],
  "include": ["src"],
  // Only the CLI/server side is emitted to `dist`: Vite bundles `src/webapp` itself (see
  // `vite.config.mts`) and the tests run from source. Both are type-checked by
  // `tsconfig.webapp.json` instead, chained into the root `typecheck` script.
  "exclude": ["src/__tests__", "src/webapp"]
}
